{%- liquid
  assign product_metafield_video_url = product.metafields.custom.product_video.value
-%}
{% if product_metafield_video_url != blank %}
  <div
    class="product-gallery--metafield-video video-container"
    style="position:relative; width:100%; height:0; padding-bottom:56.25%;"
  >
    <iframe
      src="{{ product_metafield_video_url | replace: 'watch?v=', 'embed/' }}?autoplay=1&mute=1"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      style="position:absolute; top:0; left:0; width:100%; height:100%;"
    ></iframe>
  </div>
{% endif %}
