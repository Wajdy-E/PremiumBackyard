{% liquid
  assign accent = section.settings.trust_accent_color
  if accent == blank
    assign accent = settings.color_buttons_primary_button_background
  endif

  assign accent_text = settings.color_buttons_primary_button_text
  assign surface = settings.color_layout_secondary_backgrounds
  assign border = settings.color_layout_dividers
  assign body_text = settings.color_text_regular_text
  assign message_bg = section.settings.trust_message_background
  if message_bg == blank
    assign message_bg = '#f9f9f9'
  endif
  assign heading_font = settings.type_heading.family | append: ', ' | append: settings.type_heading.fallback_families
  assign body_font = settings.type_body.family | append: ', ' | append: settings.type_body.fallback_families
%}

<div class="cart-checkout-trust" id="cart-checkout-trust-{{ section.id }}">
  <style>
    #cart-checkout-trust-{{ section.id }} {
      --cart-trust-accent: {{ accent }};
      --cart-trust-accent-text: {{ accent_text }};
      --cart-trust-surface: {{ surface }};
      --cart-trust-message-bg: {{ message_bg }};
      --cart-trust-border: {{ border }};
      --cart-trust-body: {{ body_text }};
      --cart-trust-heading-font: {{ heading_font }};
      --cart-trust-body-font: {{ body_font }};
      margin-bottom: {{ settings.type_size_base | times: 1.75 | divided_by: 16.0 | append: 'rem' }};
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-hero {
      background: #fff;
      border: 2px solid var(--cart-trust-accent);
      border-radius: {% if section.settings.trust_panel_radius > 0 %}{{ section.settings.trust_panel_radius }}px{% else %}14px{% endif %};
      padding: 2rem 1.75rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-hero h2 {
      margin: 0 0 1.75rem;
      font-family: var(--cart-trust-heading-font);
      font-weight: 700;
      font-size: clamp(1.375rem, 3vw, 1.75rem);
      color: {{ settings.color_text_headings }};
      text-align: center;
      line-height: 1.25;
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem 1rem;
      margin-bottom: 1.5rem;
    }

    @media screen and (min-width: 750px) {
      #cart-checkout-trust-{{ section.id }} .cart-trust-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1.25rem 0.75rem;
      }
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-item {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-icon {
      width: 56px;
      height: 56px;
      background: var(--cart-trust-accent);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 0.875rem;
      flex-shrink: 0;
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-icon svg {
      width: 32px;
      height: 32px;
      display: block;
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-label {
      font-family: var(--cart-trust-body-font);
      font-weight: 700;
      font-size: 0.9375rem;
      color: {{ settings.color_text_headings }};
      line-height: 1.35;
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-message {
      background-color: var(--cart-trust-message-bg);
      border: 1px solid var(--cart-trust-border);
      border-left: 5px solid var(--cart-trust-accent);
      padding: 1.125rem 1.25rem;
      border-radius: 8px;
      font-family: var(--cart-trust-body-font);
      font-size: var(--font-size-body, 0.875rem);
      line-height: 1.6;
      text-align: left;
      color: {{ settings.color_text_regular_text }};
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-message p,
    #cart-checkout-trust-{{ section.id }} .cart-trust-message li,
    #cart-checkout-trust-{{ section.id }} .cart-trust-message div {
      background: transparent;
      color: {{ settings.color_text_regular_text }};
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-message p {
      margin: 0 0 0.75rem;
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-message p:last-child {
      margin-bottom: 0;
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-message strong {
      color: var(--cart-trust-accent);
      font-weight: 700;
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-checkout-wrap {
      margin-top: 1.25rem;
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-checkout-btn {
      display: block;
      width: 100%;
      margin: 0;
      padding: 1rem 1.25rem;
      box-sizing: border-box;
      font-family: var(--cart-trust-heading-font);
      font-weight: 700;
      font-size: 1.0625rem;
      line-height: 1.25;
      color: var(--cart-trust-accent-text);
      background: var(--cart-trust-accent);
      border: 2px solid var(--cart-trust-accent);
      border-radius: 8px;
      cursor: pointer;
      text-align: center;
      transition: filter 0.2s ease, transform 0.15s ease;
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-checkout-btn:hover:not(:disabled) {
      filter: brightness(0.94);
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-checkout-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-footer-note {
      text-align: center;
      font-family: var(--cart-trust-body-font);
      font-size: 0.8125rem;
      color: {{ settings.color_text_light_text }};
      margin-top: 1rem;
      line-height: 1.6;
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-footer-note a {
      color: var(--cart-trust-accent);
      text-decoration: none;
      font-weight: 600;
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-footer-note a:hover {
      text-decoration: underline;
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-payment {
      margin-top: {{ settings.type_size_base | divided_by: 16.0 | append: 'rem' }};
      padding: 1rem 1.25rem;
      background: #fff;
      border: 1px solid var(--cart-trust-border);
      border-radius: 8px;
      text-align: center;
      font-family: var(--cart-trust-heading-font);
      font-size: 0.875rem;
      line-height: 1.5;
      color: {{ settings.color_text_headings }};
    }

    #cart-checkout-trust-{{ section.id }} .cart-trust-payment-label {
      font-weight: 700;
      margin-right: 0.35rem;
    }

    @media (max-width: 900px) {
      #cart-checkout-trust-{{ section.id }} .cart-trust-hero {
        padding: 1.75rem 1.25rem;
      }
    }

    @media (max-width: 400px) {
      #cart-checkout-trust-{{ section.id }} .cart-trust-grid {
        gap: 1rem 0.75rem;
      }
      #cart-checkout-trust-{{ section.id }} .cart-trust-icon {
        width: 48px;
        height: 48px;
      }
      #cart-checkout-trust-{{ section.id }} .cart-trust-icon svg {
        width: 28px;
        height: 28px;
      }
      #cart-checkout-trust-{{ section.id }} .cart-trust-label {
        font-size: 0.875rem;
      }
    }
  </style>

  <div class="cart-trust-hero">
    {% if section.settings.trust_heading != blank %}
      <h2>{{ section.settings.trust_heading | escape }}</h2>
    {% endif %}

    <div class="cart-trust-grid">
      {% for i in (1..4) %}
        {% assign ik = 'trust_icon_' | append: i %}
        {% assign lk = 'trust_label_' | append: i %}
        {% assign label = section.settings[lk] %}
        {% if label != blank %}
          <div class="cart-trust-item">
            <div class="cart-trust-icon" aria-hidden="true">
              {% assign icon = section.settings[ik] | default: 'lock' %}
              {% case icon %}
                {% when 'lock' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--cart-trust-accent-text);">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                {% when 'truck' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--cart-trust-accent-text);">
                    <rect x="1" y="6" width="15" height="12" rx="2"></rect>
                    <path d="M17 8h3a2 2 0 0 1 2 2v8"></path>
                    <circle cx="5.5" cy="21" r="2.5"></circle>
                    <circle cx="18.5" cy="21" r="2.5"></circle>
                  </svg>
                {% when 'maple' %}
                  <svg viewBox="0 0 32 32" fill="currentColor" stroke="currentColor" stroke-width="1.088" stroke-linejoin="round" stroke-linecap="round" style="color: var(--cart-trust-accent-text);" aria-hidden="true">
                    <path d="M16.361,31h-0.72v-6.592l-7.596,0.949c-0.124,0.015-0.245-0.034-0.323-0.129 c-0.079-0.096-0.103-0.225-0.063-0.343l0.917-2.753l-7.792-5.845c-0.107-0.081-0.161-0.213-0.14-0.346s0.115-0.242,0.242-0.284 l2.606-0.869L1.678,11.16c-0.063-0.126-0.047-0.277,0.041-0.386s0.23-0.16,0.368-0.124l3.677,0.919l0.895-2.684 c0.039-0.119,0.137-0.208,0.259-0.237C7.039,8.62,7.167,8.656,7.255,8.744l4.126,4.125L9.649,5.078 c-0.028-0.126,0.014-0.259,0.11-0.345c0.097-0.087,0.234-0.115,0.355-0.074l2.727,0.909l2.852-4.752c0.13-0.217,0.487-0.217,0.617,0 l2.852,4.752l2.727-0.909c0.126-0.041,0.259-0.013,0.355,0.074c0.097,0.086,0.139,0.219,0.11,0.345l-1.731,7.793l4.125-4.125 c0.088-0.088,0.215-0.125,0.338-0.096c0.121,0.029,0.219,0.118,0.259,0.237l0.895,2.684l3.677-0.919 c0.133-0.033,0.28,0.014,0.368,0.124c0.088,0.109,0.104,0.26,0.041,0.386L28.51,14.79l2.606,0.869 c0.127,0.042,0.22,0.151,0.241,0.284c0.021,0.133-0.032,0.265-0.14,0.346l-7.792,5.844l0.918,2.754 c0.039,0.118,0.015,0.247-0.063,0.343c-0.077,0.096-0.192,0.146-0.323,0.129l-7.596-0.949V31z M1.766,16.124l7.451,5.588 c0.124,0.093,0.175,0.255,0.125,0.402l-0.819,2.458l7.434-0.93c0.03-0.005,0.06-0.003,0.089,0l7.434,0.93l-0.819-2.458 c-0.049-0.147,0.002-0.31,0.126-0.402l7.45-5.588l-2.349-0.783c-0.099-0.033-0.179-0.107-0.219-0.204 c-0.039-0.096-0.036-0.206,0.011-0.299l1.65-3.3l-3.241,0.81c-0.185,0.047-0.369-0.058-0.429-0.235l-0.815-2.447l-4.588,4.588 c-0.113,0.114-0.29,0.138-0.428,0.061c-0.141-0.077-0.213-0.237-0.179-0.394l1.862-8.379l-2.397,0.799 c-0.161,0.055-0.336-0.011-0.423-0.156L16.001,1.7L13.31,6.185c-0.087,0.145-0.264,0.209-0.422,0.156L10.49,5.542l1.863,8.379 c0.035,0.156-0.038,0.317-0.178,0.394c-0.141,0.079-0.314,0.052-0.428-0.061L7.158,9.667l-0.816,2.447 c-0.059,0.179-0.245,0.282-0.429,0.235l-3.241-0.81l1.65,3.3c0.047,0.093,0.051,0.203,0.011,0.299 c-0.04,0.097-0.12,0.171-0.219,0.204L1.766,16.124z"></path>
                  </svg>
                {% when 'star' %}
                  <svg viewBox="0 0 24 24" fill="currentColor" style="color: var(--cart-trust-accent-text);">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                  </svg>
                {% when 'phone' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--cart-trust-accent-text);">
                    <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                    <path d="M12 18h.01"></path>
                  </svg>
                {% when 'check' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--cart-trust-accent-text);">
                    <path d="M20 6L9 17l-5-5"></path>
                  </svg>
                {% when 'wrench' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--cart-trust-accent-text);">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                  </svg>
                {% else %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--cart-trust-accent-text);">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
              {% endcase %}
            </div>
            <div class="cart-trust-label">{{ label | escape }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.trust_message != blank %}
      <div class="cart-trust-message rte">{{ section.settings.trust_message }}</div>
    {% endif %}

    {% if section.settings.checkout_button_inside_trust_panel %}
      <div class="cart-trust-checkout-wrap">
        <button
          type="submit"
          name="checkout"
          form="cart-form"
          class="cart-trust-checkout-btn"
          aria-label="{% if section.settings.checkout_button_label != blank %}{{ section.settings.checkout_button_label | escape }}{% else %}{{ 'cart.general.checkout' | t | escape }}{% endif %}"
        >
          {% if section.settings.checkout_button_label != blank %}
            {{ section.settings.checkout_button_label | escape }}
          {% else %}
            {{ 'cart.general.checkout' | t }}
          {% endif %}
        </button>
      </div>
    {% endif %}

    {% if section.settings.trust_footer_note != blank %}
      <div class="cart-trust-footer-note rte">{{ section.settings.trust_footer_note }}</div>
    {% endif %}
  </div>

  {% if section.settings.show_payment_bar %}
    <div class="cart-trust-payment">
      {% if section.settings.payment_bar_label != blank %}
        <span class="cart-trust-payment-label">{{ section.settings.payment_bar_label | escape }}</span>
      {% endif %}
      <span class="cart-trust-payment-methods">{{ section.settings.payment_methods_text | escape }}</span>
    </div>
  {% endif %}
</div>
