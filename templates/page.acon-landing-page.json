r-spacing:0.12em; text-transform:uppercase; color:var(--grey); margin-bottom:2px; }\n  .pricing-you-pay-amt { font-family:'Bitter',serif; font-weight:900; font-size:26px; color:var(--black); }\n  .pricing-saving { text-align:right; }\n  .pricing-saving-label { font-size:10px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:var(--grey); margin-bottom:2px; }\n  .pricing-saving-amt { font-family:'Bitter',serif; font-weight:900; font-size:20px; }\n\n  .result-rationale { font-size:13px; color:var(--grey-md); line-height:1.7; margin-bottom:12px; font-style:italic; border-left:3px solid; padding-left:13px; }\n\n  .result-includes { background:var(--offwhite); border:1px solid var(--border); padding:13px 15px; margin-bottom:10px; }\n  .includes-label { font-size:10px; font-weight:700; letter-spacing:0.16em; text-transform:uppercase; color:var(--grey); margin-bottom:8px; }\n  .includes-list { list-style:none; display:flex; flex-direction:column; gap:5px; }\n  .includes-list li { font-size:12px; color:var(--grey-md); display:flex; align-items:flex-start; gap:7px; }\n  .includes-list li::before { content:''; width:4px; height:4px; border-radius:50%; flex-shrink:0; margin-top:5px; }\n  .includes-list li.safety-item { color:var(--grey); font-style:italic; }\n\n  /* SAFETY NOTE */\n  .safety-note { background:#f0f7f0; border:1px solid #c8e6c9; padding:10px 13px; margin-bottom:10px; display:flex; align-items:flex-start; gap:9px; }\n  .safety-note-icon { font-size:14px; flex-shrink:0; margin-top:1px; }\n  .safety-note-text { font-size:11px; color:#2e5e2e; line-height:1.6; font-weight:600; }\n\n  /* INGROUND NOTE */\n  .inground-note { background:#f0f7ff; border:1px solid #c8dff5; padding:10px 13px; margin-bottom:12px; display:flex; align-items:flex-start; gap:9px; }\n  .inground-icon { font-size:14px; flex-shrink:0; margin-top:1px; }\n  .inground-text { font-size:11px; color:#2a4a6b; line-height:1.6; }\n  .inground-text strong { font-weight:700; display:block; margin-bottom:1px; font-size:10px; letter-spacing:0.08em; text-transform:uppercase; }\n\n  .btn-cta { width:100%; color:var(--white); border:none; font-family:'Bitter',serif; font-size:14px; font-weight:700; letter-spacing:0.07em; text-transform:uppercase; padding:14px; cursor:pointer; margin-bottom:8px; transition:opacity 0.15s,transform 0.15s; }\n  .btn-cta:hover { opacity:0.88; transform:translateY(-1px); }\n  .btn-nudge { width:100%; background:none; border:1.5px solid var(--border); color:var(--grey); font-family:'Bitter',serif; font-size:12px; font-weight:600; letter-spacing:0.07em; text-transform:uppercase; padding:10px; cursor:pointer; margin-bottom:7px; transition:border-color 0.15s,color 0.15s; }\n  .btn-nudge:hover { border-color:#999; color:var(--grey-md); }\n  .btn-retake { width:100%; background:none; border:none; color:#bbb; font-family:'Bitter',serif; font-size:11px; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; padding:6px; cursor:pointer; transition:color 0.15s; }\n  .btn-retake:hover { color:var(--grey); }\n\n  /* Tier themes */\n  .t1-theme .result-badge,.t1-theme .result-subtitle { color:var(--t1); }\n  .t1-theme .result-rationale { border-color:var(--t1); }\n  .t1-theme .pricing-saving-amt { color:var(--t1); }\n  .t1-theme .btn-cta { background:var(--t1); }\n  .t1-theme .includes-list li::before { background:var(--t1); }\n\n  .t2-theme .result-badge,.t2-theme .result-subtitle { color:var(--t2); }\n  .t2-theme .result-rationale { border-color:var(--t2); }\n  .t2-theme .pricing-saving-amt { color:var(--t2); }\n  .t2-theme .btn-cta { background:var(--t2); }\n  .t2-theme .includes-list li::before { background:var(--t2); }\n\n  .t3-theme .result-badge,.t3-theme .result-subtitle { color:var(--t3); }\n  .t3-theme .result-rationale { border-color:var(--t3); }\n  .t3-theme .pricing-saving-amt { color:var(--t3); }\n  .t3-theme .btn-cta { background:var(--t3); }\n  .t3-theme .includes-list li::before { background:var(--t3); }\n\n  .