w you your package value.</div>\n    </div>\n\n    <div class=\"progress-wrap\">\n      <div class=\"progress-track\"><div class=\"progress-fill\" id=\"progressFill\"></div></div>\n      <div class=\"progress-meta\">\n<span id=\"progressText\">Question 1 of 3</span><span id=\"progressPct\">0%</span>\n</div>\n    </div>\n\n    <div class=\"acon-modal-body\">\n\n      <!-- Q1 -->\n      <div class=\"screen active\" id=\"q1\">\n        <div class=\"q-text\">Who is primarily using this trampoline?</div>\n        <div class=\"q-hint\">Be honest — this shapes everything about the right configuration</div>\n        <div class=\"options\">\n          <div class=\"opt\" onclick=\"selectOpt(this,'q1','young_kids')\">\n            <div class=\"opt-icon\">🧒</div>\n            <div class=\"opt-content\">\n<div class=\"opt-label\">Young kids (under 10)</div>\n<div class=\"opt-desc\">Safety and confidence are the priority</div>\n</div>\n            <div class=\"opt-tag tag-family\">Family</div>\n<div class=\"opt-check\"></div>\n          </div>\n          <div class=\"opt\" onclick=\"selectOpt(this,'q1','mixed_family')\">\n            <div class=\"opt-icon\">👨‍👩‍👧‍👦</div>\n            <div class=\"opt-content\">\n<div class=\"opt-label\">Mixed family — all ages jumping</div>\n<div class=\"opt-desc\">Kids, teens, adults sharing it together</div>\n</div>\n            <div class=\"opt-tag tag-family\">Family</div>\n<div class=\"opt-check\"></div>\n          </div>\n          <div class=\"opt\" onclick=\"selectOpt(this,'q1','teen_athlete')\">\n            <div class=\"opt-icon\">🤸</div>\n            <div class=\"opt-content\">\n<div class=\"opt-label\">Teens or young athletes pushing limits</div>\n<div class=\"opt-desc\">Tricks, freestyle, serious progression</div>\n</div>\n            <div class=\"opt-tag tag-athlete\">Athlete</div>\n<div class=\"opt-check\"></div>\n          </div>\n          <div class=\"opt\" onclick=\"selectOpt(this,'q1','adult_athlete')\">\n            <div class=\"opt-icon\">🏅</div>\n            <div class=\"opt-content\">\n<div class=\"opt-label\">Adult athlete — fitness or training</div>\n<div class=\"opt-desc\">Conditioning, skill work, serious use</div>\n</div>\n            <div class=\"opt-tag tag-athlete\">Athlete</div>\n<div class=\"opt-check\"></div>\n          </div>\n        </div>\n        <button class=\"btn-next\" id=\"next1\" onclick=\"nextQ(2)\">Next Question →</button>\n      </div>\n\n      <!-- Q2 -->\n      <div class=\"screen\" id=\"q2\">\n        <div class=\"q-text\">What does jumping actually look like?</div>\n        <div class=\"q-hint\">Picture it — what's really happening on this trampoline</div>\n        <div class=\"options\">\n          <div class=\"opt\" onclick=\"selectOpt(this,'q2','safe_fun')\">\n            <div class=\"opt-icon\">😄</div>\n            <div class=\"opt-content\">\n<div class=\"opt-label\">Safe fun, exercise, and outdoor play</div>\n<div class=\"opt-desc\">Nothing extreme — joy, play, fresh Canadian air</div>\n</div>\n            <div class=\"opt-tag tag-family\">Family</div>\n<div class=\"opt-check\"></div>\n          </div>\n          <div class=\"opt\" onclick=\"selectOpt(this,'q2','active_bouncing')\">\n            <div class=\"opt-icon\">⚡</div>\n            <div class=\"opt-content\">\n<div class=\"opt-label\">Active bouncing — higher, some tricks</div>\n<div class=\"opt-desc\">More than casual, not quite competitive</div>\n</div>\n            <div class=\"opt-tag tag-family\">Family+</div>\n<div class=\"opt-check\"></div>\n          </div>\n          <div class=\"opt\" onclick=\"selectOpt(this,'q2','freestyle_skills')\">\n            <div class=\"opt-icon\">🔥</div>\n            <div class=\"opt-content\">\n<div class=\"opt-label\">Freestyle moves and skill progression</div>\n<div class=\"opt-desc\">Flips, body control, pushing the limits</div>\n</div>\n            <div class=\"opt-tag tag-athlete\">Athlete</div>\n<div class=\"opt-check\"></div>\n          </div>\n          <div class=\"opt\" onclick=\"selectOpt(this,'q2','structured_training')\">\n            <div class=\"opt-icon\">🎯</div>\n            <div class=\"opt-content\">\n<div class=\"opt-label\">Structured training and drills</div>\n<div class=\"opt-desc\">Conditioning, repetition, serious progression</div>\n</div>\n            <div class=\"opt-tag tag-elite\">Elite</div>\n<div class=\"opt-check\"></div>\n          </div>\n        </div>\n        <button class=\"btn-next\" id=\"next2\" onclick=\"nextQ(3)\">Next Question →</button>\n      </div>\n\n      <!-- Q3 -->\n      <div class=\"screen\" id=\"q3\">\n        <div class=\"q-text\">What matters most to you?</div>\n        <div class=\"q-hint\">This is the question that separates good from exceptional</div>\n        <div class=\"options\">\n          <div class=\"opt\" onclick=\"selectOpt(this,'q3','solid_safe')\">\n            <div class=\"opt-icon\">🛡️</div>\n            <div class=\"opt-content\">\n<div class=\"opt-label\">Solid, safe, and built to last</div>\n<div class=\"opt-desc\">Reliability and safety above all else</div>\n</div>\n            <div class=\"opt-tag tag-family\">Family</div>\n<div class=\"opt-check\"></div>\n          </div>\n          <div class=\"opt\" onclick=\"selectOpt(this,'q3','room_to_grow')\">\n            <div class=\"opt-icon\">📈</div>\n            <div class=\"opt-content\">\n<div class=\"opt-label\">Room to grow as skills improve</div>\n<div class=\"opt-desc\">Start great, level up over time</div>\n</div>\n            <div class=\"opt-tag tag-family\">Family+</div>\n<div class=\"opt-check\"></div>\n          </div>\n          <div class=\"opt\" onclick=\"selectOpt(this,'q3','best_feel')\">\n            <div class=\"opt-icon\">🏆</div>\n            <div class=\"opt-content\">\n<div class=\"opt-label\">Best performance feel from day one</div>\n<div class=\"opt-desc\">Athletic response, precision, no compromise on bounce</div>\n</div>\n            <div class=\"opt-tag tag-athlete\">Athlete</div>\n<div class=\"opt-check\"></div>\n          </div>\n          <div class=\"opt\" onclick=\"selectOpt(this,'q3','no_ceiling')\">\n            <div class=\"opt-icon\">💎</div>\n            <div class=\"opt-content\">\n<div class=\"opt-label\">The very best available — nothing held back</div>\n<div class=\"opt-desc\">Elite equipment built for the serious jumper</div>\n</div>\n            <div class=\"opt-tag tag-elite\">Elite</div>\n<div class=\"opt-check\"></div>\n          </div>\n        </div>\n        <button class=\"btn-next\" id=\"next3\" onclick=\"showResult()\">See My Configuration →</button>\n      </div>\n\n      <div class=\"screen\" id=\"result\"></div>\n    </div>\n  </div>\n</div>\n\n<script>\n// -----------------------------\n// STATE\n// -----------------------------\nconst answers = { q1:null, q2:null, q3:null };\n\n// -----------------------------\n// TIERS (WITH VARIANT IDS)\n// -----------------------------\nconst tiers = {\n  t1:{\n    variantId:52148207419666,\n    theme:'t1-theme',\n    badge:'Configuration 1 · Performance',\n    title:'ACON X17 Performance',\n    subtitle:'The Family Foundation',\n    retail:null,\n    custPays:'$6,299.99',\n    saving:'Included',\n    savingAmt:'Included',\n    includes:[\n      {text:'ACON X17 Trampoline + Safety Net & Ladder',safety:false},\n      {text:'Performance Spring Kit — 42 springs',safety:false},\n      {text:'Height Adjustment Kit',safety:true},\n      {text:'Inflatable Safety Block',safety:true},\n    ],\n    cta:'Select Performance Configuration',\n    nudge:'Step up to Configuration 2 — a better mat, more capability',\n  },\n  t2:{\n    variantId:52149434450194,\n    theme:'t2-theme',\n    badge:'Configuration 2 · Performance+',\n    title:'ACON X17 Performance+',\n    subtitle:'The Active Family Upgrade',\n    retail:'$7,299.99',\n    custPays:'$6,799.99',\n    saving:'You Save',\n    savingAmt:'$500 CAD',\n    includes:[\n      {text:'ACON X17 Trampoline + Safety Net & Ladder',safety:false},\n      {text:'Performance Mat',safety:false},\n      {text:'Performance Spring Kit — 42 springs',safety:false},\n      {text:'Height Adjustment Kit',safety:true},\n      {text:'Inflatable Safety Block',safety:true},\n    ],\n    cta:'Select Performance+ Configuration',\n    nudge:'Step up to Configuration 3 — Save $750 and go further',\n  },\n  t3:{\n    variantId:52149434581266,\n    theme:'t3-theme',\n    badge:'Configuration 3 · Freestyle',\n    title:'ACON X17 Freestyle',\n    subtitle:\"The Athlete's Trampoline\",\n    retail:'$10,999.99',\n    custPays:'$10,249.99',\n    saving:'You Save',\n    savingAmt:'$750 CAD',\n    includes:[\n      {text:'ACON X17 Trampoline + Safety Net & Ladder',safety:false},\n      {text:'Freestyle Mat',safety:false},\n      {text:'Super Stretch Springs — 42 springs',safety:false},\n      {text:'Crash Mat',safety:false},\n      {text:'Height Adjustment Kit',safety:true},\n      {text:'Inflatable Safety Block',safety:true},\n    ],\n    cta:'Select Freestyle Configuration',\n    nudge:'Step up to Configuration 4 — Save $1,000 and train at the highest level',\n  },\n  t4:{\n    variantId:52149967749394,\n    theme:'t4-theme',\n    badge:'Configuration 4 · Competition',\n    title:'ACON X17 Competition',\n    subtitle:'No Limits. No Compromises.',\n    retail:'$15,499.99',\n    custPays:'$14,499.99',\n    saving:'You Save',\n    savingAmt:'$1,000 CAD',\n    includes:[\n      {text:'ACON X17 Trampoline + Safety Net & Ladder',safety:false},\n      {text:'Competition Mat',safety:false},\n      {text:'Therapy Springs 220 — full set',safety:false},\n      {text:'Crash Mat',safety:false},\n      {text:'Height Adjustment Kit',safety:true},\n      {text:'Inflatable Safety Block',safety:true},\n    ],\n    cta:'Select Competition Configuration',\n    nudge:null,\n  },\n};\n\n// -----------------------------\n// NOTES\n// -----------------------------\nconst safetyNote = `<div class=\"safety-note\">🛡️ Safety upgrades included</div>`;\nconst ingroundNote = `<div class=\"inground-note\">🏡 In-ground installation compatible</div>`;\n\n// -----------------------------\n// QUIZ NAVIGATION\n// -----------------------------\nfunction selectOpt(el,q,val){\n  answers[q]=val;\n  document.querySelectorAll(`#${q} .opt`).forEach(o=>o.classList.remove('selected'));\n  el.classList.add('selected');\n  document.getElementById(`next${q.slice(1)}`).classList.add('visible');\n}\n\nfunction nextQ(n){\n  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));\n  document.getElementById(`q${n}`).classList.add('active');\n    updateProgress(n);\n\n}\n\n// -----------------------------\n// TIER LOGIC\n// -----------------------------\nfunction calcTier(){\n  const{q1,q2,q3}=answers;\n  if(q2==='structured_training'&&q3==='no_ceiling') return 't4';\n  if(q1==='adult_athlete'&&q3==='no_ceiling') return 't4';\n  if((q1==='teen_athlete'||q1==='adult_athlete')&&(q2==='freestyle_skills'||q2==='structured_training')) return 't3';\n  if(q2==='freestyle_skills'&&q3==='best_feel') return 't3';\n  if(q3==='best_feel'&&q1!=='young_kids'&&q1!=='mixed_family') return 't3';\n  if((q1==='mixed_family'||q1==='young_kids')&&q2==='active_bouncing') return 't2';\n  if(q3==='room_to_grow') return 't2';\n  if(q2==='active_bouncing'&&q3==='solid_safe') return 't2';\n  return 't1';\n}\n\n// -----------------------------\n// CART\n// -----------------------------\nfunction clearCart(){\n  return fetch('/cart/clear.js', {\n    method:'POST',\n    headers:{ 'Content-Type':'application/json' }\n  });\n}\n\nfunction addVariant(variantId){\n  return fetch('/cart/add.js', {\n    method:'POST',\n    headers:{ 'Content-Type':'application/json' },\n    body: JSON.stringify({\n      items: [{ id: variantId, quantity: 1 }]\n    })\n  })\n  .then(res => {\n    if (!res.ok) throw new Error('Add to cart failed');\n    return res.json();\n  });\n}\n\nfunction handleCTA(key){\n  const variantId = tiers[key].variantId;\n\n  console.log(\"ADDING VARIANT:\", variantId);\n\n  closeQuiz();\n\n  // -----------------------------\n  // CREATE REAL PRODUCT FORM\n  // -----------------------------\n  const form = document.createElement('form');\n  form.action = '/cart/add';\n  form.method = 'post';\n  form.classList.add('product-form'); // 👈 IMPORTANT (theme hook)\n\n  form.innerHTML = `\n    <input type=\"hidden\" name=\"id\" value=\"${variantId}\">\n    <input type=\"hidden\" name=\"quantity\" value=\"1\">\n    <button type=\"submit\" style=\"display:none;\">Add</button>\n  `;\n\n  document.body.appendChild(form);\n\n  // -----------------------------\n  // TRIGGER SUBMIT (LIKE USER)\n  // -----------------------------\n  const submitEvent = new Event('submit', {\n    bubbles: true,\n    cancelable: true\n  });\n\n  form.dispatchEvent(submitEvent);\n\n  // fallback if theme doesn't intercept\n  if (!submitEvent.defaultPrevented) {\n    form.submit();\n  }\n}\n// -----------------------------\n// BUILD RESULT\n// -----------------------------\nfunction buildResult(key,isNudge,fromKey){\n  const t = tiers[key];\n\n  return `\n    <div class=\"${t.theme}\">\n      <div class=\"result-badge\">${t.badge}</div>\n      <h2>${t.title}</h2>\n      <p>${t.subtitle}</p>\n\n      <div>\n        ${t.retail ? `<div style=\"text-decoration:line-through\">${t.retail}</div>`:''}\n        <div>${t.custPays}</div>\n        <div>${t.savingAmt}</div>\n      </div>\n\n      ${safetyNote}\n      ${ingroundNote}\n\n      <ul class=\"features-list\">\n        ${t.includes.map(i=>`<li>${i.text}</li>`).join('')}\n      </ul>\n<div class=\"button-group--quiz\">\n      <button onclick=\"handleCTA('${key}')\" class=\"btn-cta\">\n        ${t.cta}\n      </button>\n\n      ${t.nudge && !isNudge ? `\n        <button class=\"button-primary\" onclick=\"showNudge('${key}')\">\n          ${t.nudge}\n        </button>`:''}\n\n      <button onclick=\"retake()\" class=\"button-secondary\">Start Over</button>\n</div>\n    </div>\n  `;\n}\n\n// -----------------------------\n// RESULT + NUDGE\n// -----------------------------\nfunction showResult(){\nupdateProgress(4);\n\n  const key=calcTier();\n  const el=document.getElementById('result');\n\n  el.className='screen active '+tiers[key].theme;\n  el.innerHTML=buildResult(key,false,null);\n\n  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));\n  el.classList.add('active');\n\n  document.getElementById('acon-modal').scrollTop=0;\n}\n\nfunction showNudge(currentKey){\n  const map={t1:'t2',t2:'t3',t3:'t4'},key=map[currentKey];\n  if(!key) return;\n\n  const el=document.getElementById('result');\n  el.className='screen active '+tiers[key].theme;\n  el.innerHTML=buildResult(key,true,currentKey);\n\n  document.getElementById('acon-modal').scrollTop=0;\n}\n\n// -----------------------------\n// RESET\n// -----------------------------\nfunction retake(){\n  answers.q1=null;answers.q2=null;answers.q3=null;\n\n  document.querySelectorAll('.opt').forEach(o=>o.classList.remove('selected'));\n  document.querySelectorAll('.btn-next').forEach(b=>b.classList.remove('visible'));\n\nupdateProgress(1);\n\n  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));\n  document.getElementById('q1').classList.add('active');\n\n  document.getElementById('acon-modal').scrollTop=0;\n}\n\n// -----------------------------\n// MODAL\n// -----------------------------\nfunction openQuiz(){\n  document.getElementById('overlay').classList.add('active');\n}\n\nfunction closeQuiz(){\n  document.getElementById('overlay').classList.remove('active');\n}\n\nfunction handleOverlayClick(e){\n  if(e.target.id==='overlay') closeQuiz();\n}\n\n  function updateProgress(step){\n    console.log(step);\n  const total = 3;\n\n  // step = 1,2,3, or 4 (result)\n  const pct = ((step - 1) / total) * 100;\n    console.log(pct);\n\n  document.getElementById('progressFill').style.width = pct + '%';\n  document.getElementById('progressPct').textContent = Math.round(pct) + '%';\n\n  if (step <= 3) {\n    document.getElementById('progressText').textContent = `Question ${step} of 3`;\n  } else {\n    document.getElementById('progressText').textContent = 'Complete';\n  }\n}\n// -----------------------------\ndocument.addEventListener('keydown',e=>{\n  if(e.key==='Escape') closeQuiz();\n});\n</script>",
