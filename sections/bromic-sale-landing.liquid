<script>
  (() => {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    const el = root.querySelector('[data-bromic-countdown]');
    if (!el) return;

    const endRaw = el.getAttribute('data-end') || '';
    const end = new Date(endRaw);
    if (Number.isNaN(end.getTime())) return;

    const parts = {
      d: el.querySelector('[data-part="d"]'),
      h: el.querySelector('[data-part="h"]'),
      m: el.querySelector('[data-part="m"]'),
      s: el.querySelector('[data-part="s"]'),
    };

    const pad = (n) => String(n).padStart(2, '0');

    const tick = () => {
      const now = Date.now();
      const diff = Math.max(0, end.getTime() - now);
      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);

      if (parts.d) parts.d.textContent = pad(d);
      if (parts.h) parts.h.textContent = pad(h);
      if (parts.m) parts.m.textContent = pad(m);
      if (parts.s) parts.s.textContent = pad(s);
    };

    tick();
    window.setInterval(tick, 1000);
  })();
</script>

