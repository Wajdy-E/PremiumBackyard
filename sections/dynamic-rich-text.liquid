{% style %}
  #shopify-section-{{section.id}} .rich-text--inner-container {
    background-color: {{ section.settings.background_color }};
    border-radius: {{ settings.button_border_radius | append: 'px' }};
  }

  #shopify-section-{{section.id}}  .rich-text-button {
      font-size: var(--font-size-button-large);
      padding: .875rem 2.125rem;
      letter-spacing: 0em;
  }
  
  #shopify-section-{{section.id}} .rich-text--container {
    padding-top: {{ section.settings.section_spacing_mobile }}px;
    padding-bottom: {{ section.settings.section_spacing_mobile }}px;
  }

  @media screen and (min-width: 720px) {
    #shopify-section-{{section.id}} .rich-text--container {
      padding-top: {{ section.settings.section_spacing_desktop }}px;
      padding-bottom: {{ section.settings.section_spacing_desktop }}px;
    }
  }
{% endstyle %}

<script
  type="application/json"
  data-section-id="{{ section.id }}"
  data-section-type="dynamic-rich-text"
  data-section-index="{{ section.index }}"
></script>

<section
  class="
    rich-text--container
    rich-text-{{ section.settings.width }}
  "
>
  <div class="rich-text--inner-container">
    {% for block in section.blocks %}
      <div
        class="
          rich-text-block
          {% if block.type == 'text' %}
            rich-text-alignment-{{ block.settings.text_alignment }}
          {% endif %}
        "
        {{ block.shopify_attributes }}
      >
        {% if block.type == 'text' %}
          {% if block.settings.title != blank %}
            <h2
              class="
                rich-text-heading
                rich-text-heading-{{ block.settings.heading_size }}
              "
            >
              {{ block.settings.title | escape }}
            </h2>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="rich-text-content rte" data-rte>
              {{ block.settings.text }}
            </div>
          {% endif %}

          {% if block.settings.button_text != blank and block.settings.block_link != blank %}
            {%- capture button_classes -%}
              {% assign button_style = block.settings.button_style | split: "_" %}
              button-{{ button_style.first }}
              {% if button_style contains 'icon' %}
                has-icon
              {% endif %}
            {%  endcapture %}
          <a class="{{- button_classes -}} rich-text-button" href="{{ block.settings.block_link }}">
            <span class="button-text">
              {{- block.settings.button_text | escape -}}
            </span>
            {% if button_style contains 'icon' %}
              <span class="button-icon">
                {% include 'icon-library', id: 'icon-chevron-signpost' %}
              </span>
            {% endif %}
          </a>
        {% endif %}
        {% elsif block.type == 'page' and block.settings.page %}
          {% if block.settings.show_heading %}
            <h2
              class="
                rich-text-heading
                rich-text-heading-{{ block.settings.heading_size }}
              "
            >
              {{ pages[block.settings.page].title | escape }}
            </h2>
          {% endif %}

          <div class="rich-text-content rte" data-rte>
            {{ pages[block.settings.page].content }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Rich Text",
  "class": "rich-text--section",
  "max_blocks": 2,
  "settings": [
    {
      "id": "width",
      "type": "select",
      "label": "Section width",
      "options": [
        {
          "value": "regular",
          "label": "Regular"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "max-width",
          "label": "Max width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "regular"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color"
    },
    {
      "type": "range",
      "id": "section_spacing_desktop",
      "label": "Desktop section spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "section_spacing_mobile",
      "label": "Mobile section spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Rich text"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Use this section to welcome customers to your store, say a bit about your brand, or share news and seasonal promotions.</p>"
        },
        {
          "id": "heading_size",
          "type": "select",
          "label": "Heading size",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ],
          "default": "medium"
        },
        {
          "id": "text_alignment",
          "type": "text_alignment",
          "label": "Text alignment",
          "default": "left"
        },
            {
      "type": "url",
      "id": "block_link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Button"
    },
    {
      "id": "button_style",
      "type": "select",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "primary_icon",
          "label": "Primary with icon"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "secondary_icon",
          "label": "Secondary with icon"
        }
      ],
      "default": "primary"
      }
      ]
    },
    {
      "type": "page",
      "name": "Page",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_heading",
          "label": "Show heading"
        },
        {
          "id": "heading_size",
          "type": "select",
          "label": "Heading size",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ],
          "default": "medium"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "category": "Text",
      "blocks": [
        {
          "type": "text",
          "settings": {
            "title": "Rich text",
            "text": "<p>Use this section to welcome customers to your store, say a bit about your brand, or share news and seasonal promotions.</p>"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "index",
      "product",
      "page"
    ]
  }
}

{% endschema %}