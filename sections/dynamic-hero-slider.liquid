{% liquid
  assign slide_count = section.blocks.size
  assign slider_width = '100%'

  if section.settings.max_width != 'full'
    assign slider_width = section.settings.max_width | append: 'px'
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} .hero-slider-section {
    padding-top: {{ section.settings.section_spacing_mobile }}px;
    padding-bottom: {{ section.settings.section_spacing_mobile }}px;
  }

  #shopify-section-{{ section.id }} .hero-slider {
    --hero-slider-accent: {{ section.settings.accent_color }};
    --hero-slider-radius: {{ section.settings.border_radius }}px;
    --hero-slider-desktop-height: {{ section.settings.desktop_height }}px;
    --hero-slider-mobile-height: {{ section.settings.mobile_height }}px;
    width: min(100%, {{ slider_width }});
    margin: 0 auto;
    position: relative;
    overflow: hidden;
    border-radius: var(--hero-slider-radius);
    background: #0a0a0a;
    font-family: inherit;
  }

  #shopify-section-{{ section.id }} .hero-slider__viewport {
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .hero-slider__track {
    display: flex;
    transition: transform 0.6s cubic-bezier(0.77, 0, 0.18, 1);
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .hero-slider__slide {
    min-width: 100%;
    min-height: var(--hero-slider-mobile-height);
    position: relative;
    display: flex;
    align-items: stretch;
    color: var(--slide-text-color);
    background: var(--slide-background-color);
  }

  #shopify-section-{{ section.id }} .hero-slider__slide.has-pattern::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.05;
    pointer-events: none;
    background-image: repeating-linear-gradient(45deg, currentColor 0, currentColor 1px, transparent 0, transparent 20px);
  }

  #shopify-section-{{ section.id }} .hero-slider__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
    padding: 34px 22px 72px;
  }

  #shopify-section-{{ section.id }} .hero-slider__content {
    align-self: center;
    max-width: 520px;
  }

  #shopify-section-{{ section.id }} .hero-slider__badge {
    display: inline-block;
    margin-bottom: 10px;
    padding: 4px 10px;
    border-radius: 2px;
    background: var(--slide-accent-color);
    color: var(--slide-badge-color);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .hero-slider__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 10px;
    color: var(--slide-accent-color);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .hero-slider__eyebrow::before {
    content: "";
    width: 20px;
    height: 2px;
    flex: 0 0 auto;
    background: currentColor;
  }

  #shopify-section-{{ section.id }} .hero-slider__heading {
    margin: 0;
    color: var(--slide-text-color);
    font-family: inherit;
    font-size: clamp(2rem, 11vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .hero-slider__heading-highlight {
    color: var(--slide-accent-color);
    font-style: normal;
  }

  #shopify-section-{{ section.id }} .hero-slider__body {
    margin-top: 14px;
    max-width: 440px;
    color: var(--slide-muted-color);
    font-size: 1rem;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .hero-slider__body p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .hero-slider__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  #shopify-section-{{ section.id }} .hero-slider__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 18px;
    border-radius: {{ settings.button_border_radius | default: 3 }}px;
    border: 1px solid transparent;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .hero-slider__button--primary {
    background: var(--slide-accent-color);
    color: var(--slide-button-color);
  }

  #shopify-section-{{ section.id }} .hero-slider__button--secondary {
    background: transparent;
    border-color: var(--slide-secondary-border-color);
    color: var(--slide-secondary-color);
  }

  #shopify-section-{{ section.id }} .hero-slider__media {
    align-self: center;
    display: grid;
    gap: 14px;
  }

  #shopify-section-{{ section.id }} .hero-slider__media-card {
    min-height: 190px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px;
    border: 1px solid var(--slide-media-border-color);
    border-radius: 8px;
    color: var(--slide-muted-color);
    background: var(--slide-media-background-color);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .hero-slider__media-card img,
  #shopify-section-{{ section.id }} .hero-slider__media-card .rimg {
    width: 100%;
    height: 100%;
    object-fit: var(--slide-image-fit);
  }

  #shopify-section-{{ section.id }} .hero-slider__media-image {
    width: 100%;
    max-height: 260px;
    object-fit: var(--slide-image-fit);
  }

  #shopify-section-{{ section.id }} .hero-slider__media-caption {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .hero-slider__media-caption span {
    display: block;
    margin-top: 3px;
    color: var(--slide-text-color);
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
  }

  #shopify-section-{{ section.id }} .hero-slider__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    width: 42px;
    height: 42px;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 3px;
    background: rgba(0, 0, 0, 0.25);
    color: #fff;
    cursor: pointer;
    font-size: 1.75rem;
    line-height: 1;
    transform: translateY(-50%);
    transition: background-color 0.2s, border-color 0.2s;
  }

  #shopify-section-{{ section.id }} .hero-slider__arrow:hover {
    background: var(--hero-slider-accent);
    border-color: transparent;
  }

  #shopify-section-{{ section.id }} .hero-slider__arrow--previous {
    left: 14px;
  }

  #shopify-section-{{ section.id }} .hero-slider__arrow--next {
    right: 14px;
  }

  #shopify-section-{{ section.id }} .hero-slider__controls {
    position: absolute;
    right: 16px;
    bottom: 16px;
    left: 16px;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .hero-slider__dots {
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .hero-slider__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
    transition: width 0.3s, background-color 0.3s;
  }

  #shopify-section-{{ section.id }} .hero-slider__dot.is-active {
    width: 24px;
    background: var(--hero-slider-accent);
  }

  #shopify-section-{{ section.id }} .hero-slider__counter {
    position: absolute;
    right: 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  #shopify-section-{{ section.id }} .hero-slider__progress {
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 3;
    width: 0;
    height: 3px;
    background: var(--hero-slider-accent);
  }

  #shopify-section-{{ section.id }} .hero-slider.is-playing .hero-slider__progress {
    animation-name: hero-slider-progress-{{ section.id }};
    animation-timing-function: linear;
    animation-fill-mode: forwards;
    animation-duration: var(--hero-slider-autoplay-duration);
  }

  @keyframes hero-slider-progress-{{ section.id }} {
    from { width: 0; }
    to { width: 100%; }
  }

  @media screen and (min-width: 720px) {
    #shopify-section-{{ section.id }} .hero-slider-section {
      padding-top: {{ section.settings.section_spacing_desktop }}px;
      padding-bottom: {{ section.settings.section_spacing_desktop }}px;
    }

    #shopify-section-{{ section.id }} .hero-slider__slide {
      min-height: var(--hero-slider-desktop-height);
    }

    #shopify-section-{{ section.id }} .hero-slider__inner {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      gap: 32px;
      padding: 54px 72px;
    }

    #shopify-section-{{ section.id }} .hero-slider__slide--image-left .hero-slider__content {
      order: 2;
    }

    #shopify-section-{{ section.id }} .hero-slider__slide--image-left .hero-slider__media {
      order: 1;
    }

    #shopify-section-{{ section.id }} .hero-slider__slide--no-image .hero-slider__inner {
      grid-template-columns: minmax(0, 680px);
      justify-content: center;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .hero-slider__slide--no-image .hero-slider__content,
    #shopify-section-{{ section.id }} .hero-slider__slide--no-image .hero-slider__body {
      margin-right: auto;
      margin-left: auto;
    }

    #shopify-section-{{ section.id }} .hero-slider__slide--split .hero-slider__media {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .hero-slider__media-card {
      min-height: 260px;
    }

    #shopify-section-{{ section.id }} .hero-slider__arrow {
      display: flex;
    }
  }

  @media screen and (max-width: 719px) {
    #shopify-section-{{ section.id }} .hero-slider {
      border-radius: min(var(--hero-slider-radius), 8px);
    }

    #shopify-section-{{ section.id }} .hero-slider__media {
      order: -1;
    }

    #shopify-section-{{ section.id }} .hero-slider__slide--no-image .hero-slider__media {
      display: none;
    }

    #shopify-section-{{ section.id }} .hero-slider__media-card {
      min-height: 160px;
    }

    #shopify-section-{{ section.id }} .hero-slider__content {
      max-width: none;
    }

    #shopify-section-{{ section.id }} .hero-slider__heading {
      max-width: 12ch;
    }

    #shopify-section-{{ section.id }} .hero-slider__buttons {
      flex-direction: column;
      align-items: stretch;
    }

    #shopify-section-{{ section.id }} .hero-slider__button {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .hero-slider__counter {
      display: none;
    }
  }
{% endstyle %}

<script
  type="application/json"
  data-section-type="dynamic-hero-slider"
  data-section-id="{{ section.id }}"
  data-section-index="{{ section.index }}"
  data-section-data
>
  {
    "autoplay": {{ section.settings.enable_autoplay | json }},
    "duration": {{ section.settings.autoplay_duration | times: 1000 | json }},
    "slideCount": {{ slide_count | json }}
  }
</script>

<section class="hero-slider-section" aria-label="{{ section.settings.accessibility_label | escape }}">
  <div
    class="hero-slider"
    data-hero-slider
    style="--hero-slider-autoplay-duration: {{ section.settings.autoplay_duration }}s;"
  >
    <div class="hero-slider__viewport">
      <div class="hero-slider__track" data-hero-slider-track>
        {% for block in section.blocks %}
          {% liquid
            assign slide_layout = block.settings.layout
            assign primary_image = block.settings.image
            assign primary_image_url = block.settings.image_url
            assign secondary_image = block.settings.secondary_image
            assign secondary_image_url = block.settings.secondary_image_url
          %}

          <article
            class="
              hero-slider__slide
              hero-slider__slide--{{ slide_layout }}
              {% if block.settings.show_pattern %}has-pattern{% endif %}
              {% if forloop.first %}is-active{% endif %}
            "
            style="
              --slide-background-color: {{ block.settings.background_color }};
              --slide-text-color: {{ block.settings.text_color }};
              --slide-muted-color: {{ block.settings.muted_text_color }};
              --slide-accent-color: {{ block.settings.accent_color }};
              --slide-badge-color: {{ block.settings.badge_text_color }};
              --slide-button-color: {{ block.settings.button_text_color }};
              --slide-secondary-color: {{ block.settings.secondary_button_color }};
              --slide-secondary-border-color: {{ block.settings.secondary_button_border_color }};
              --slide-media-background-color: {{ block.settings.media_background_color }};
              --slide-media-border-color: {{ block.settings.media_border_color }};
              --slide-image-fit: {{ block.settings.image_fit }};
            "
            data-hero-slider-slide
            aria-label="Slide {{ forloop.index }} of {{ slide_count }}"
            {{ block.shopify_attributes }}
          >
            <div class="hero-slider__inner">
              <div class="hero-slider__content">
                {% if block.settings.badge != blank %}
                  <div class="hero-slider__badge">{{ block.settings.badge | escape }}</div>
                {% endif %}

                {% if block.settings.eyebrow != blank %}
                  <p class="hero-slider__eyebrow">{{ block.settings.eyebrow | escape }}</p>
                {% endif %}

                {% if block.settings.heading != blank or block.settings.heading_highlight != blank %}
                  <h2 class="hero-slider__heading">
                    {% if block.settings.heading != blank %}
                      {{ block.settings.heading | escape }}
                    {% endif %}
                    {% if block.settings.heading_highlight != blank %}
                      <em class="hero-slider__heading-highlight">{{ block.settings.heading_highlight | escape }}</em>
                    {% endif %}
                  </h2>
                {% endif %}

                {% if block.settings.text != blank %}
                  <div class="hero-slider__body rte" data-rte>
                    {{ block.settings.text }}
                  </div>
                {% endif %}

                {% if block.settings.primary_button_label != blank or block.settings.secondary_button_label != blank %}
                  <div class="hero-slider__buttons">
                    {% if block.settings.primary_button_label != blank %}
                      {% if block.settings.primary_button_link != blank %}
                        <a class="hero-slider__button hero-slider__button--primary" href="{{ block.settings.primary_button_link }}">
                          {{ block.settings.primary_button_label | escape }}
                        </a>
                      {% else %}
                        <span class="hero-slider__button hero-slider__button--primary">
                          {{ block.settings.primary_button_label | escape }}
                        </span>
                      {% endif %}
                    {% endif %}

                    {% if block.settings.secondary_button_label != blank %}
                      {% if block.settings.secondary_button_link != blank %}
                        <a class="hero-slider__button hero-slider__button--secondary" href="{{ block.settings.secondary_button_link }}">
                          {{ block.settings.secondary_button_label | escape }}
                        </a>
                      {% else %}
                        <span class="hero-slider__button hero-slider__button--secondary">
                          {{ block.settings.secondary_button_label | escape }}
                        </span>
                      {% endif %}
                    {% endif %}
                  </div>
                {% endif %}
              </div>

              {% unless slide_layout == 'no-image' %}
                <div class="hero-slider__media">
                  <div class="hero-slider__media-card">
                    {% if primary_image != blank %}
                      {% render 'rimg',
                        img: primary_image,
                        size: '900x700',
                        class: 'hero-slider__media-image',
                        lazy: true,
                        canvas: true,
                        focal_point: primary_image.presentation.focal_point
                      %}
                    {% elsif primary_image_url != blank %}
                      <img class="hero-slider__media-image" src="{{ primary_image_url | escape }}" alt="{{ block.settings.image_alt | escape }}" width="900" height="700" loading="lazy">
                    {% elsif block.settings.image_placeholder != blank %}
                      <span>{{ block.settings.image_placeholder | escape }}</span>
                    {% endif %}

                    {% if block.settings.image_caption != blank %}
                      <div class="hero-slider__media-caption">
                        {{ block.settings.image_caption | escape }}
                        {% if block.settings.image_caption_detail != blank %}
                          <span>{{ block.settings.image_caption_detail | escape }}</span>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>

                  {% if slide_layout == 'split' %}
                    <div class="hero-slider__media-card">
                      {% if secondary_image != blank %}
                        {% render 'rimg',
                          img: secondary_image,
                          size: '900x700',
                          class: 'hero-slider__media-image',
                          lazy: true,
                          canvas: true,
                          focal_point: secondary_image.presentation.focal_point
                        %}
                      {% elsif secondary_image_url != blank %}
                        <img class="hero-slider__media-image" src="{{ secondary_image_url | escape }}" alt="{{ block.settings.secondary_image_alt | escape }}" width="900" height="700" loading="lazy">
                      {% elsif block.settings.secondary_image_placeholder != blank %}
                        <span>{{ block.settings.secondary_image_placeholder | escape }}</span>
                      {% endif %}

                      {% if block.settings.secondary_image_caption != blank %}
                        <div class="hero-slider__media-caption">
                          {{ block.settings.secondary_image_caption | escape }}
                          {% if block.settings.secondary_image_caption_detail != blank %}
                            <span>{{ block.settings.secondary_image_caption_detail | escape }}</span>
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              {% endunless %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>

    {% if section.settings.show_arrows and slide_count > 1 %}
      <button class="hero-slider__arrow hero-slider__arrow--previous" type="button" aria-label="Previous slide" data-hero-slider-previous>
        ‹
      </button>
      <button class="hero-slider__arrow hero-slider__arrow--next" type="button" aria-label="Next slide" data-hero-slider-next>
        ›
      </button>
    {% endif %}

    {% if slide_count > 1 %}
      <div class="hero-slider__controls">
        {% if section.settings.show_dots %}
          <div class="hero-slider__dots" role="tablist" aria-label="Choose slide">
            {% for block in section.blocks %}
              <button
                class="hero-slider__dot {% if forloop.first %}is-active{% endif %}"
                type="button"
                aria-label="Show slide {{ forloop.index }}"
                data-hero-slider-dot="{{ forloop.index0 }}"
              ></button>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.show_counter %}
          <div class="hero-slider__counter" aria-live="polite" data-hero-slider-counter>
            <strong>1</strong> / {{ slide_count }}
          </div>
        {% endif %}
      </div>

      {% if section.settings.show_progress %}
        <div class="hero-slider__progress" data-hero-slider-progress></div>
      {% endif %}
    {% endif %}
  </div>
</section>

<script>
  (function () {
    var sliders = document.querySelectorAll('[data-hero-slider]');
    if (!sliders.length) return;

    sliders.forEach(function (slider) {
      if (slider.dataset.heroSliderInitialized === 'true') return;
      slider.dataset.heroSliderInitialized = 'true';

      var section = slider.closest('.shopify-section');
      var data = section ? section.querySelector('[data-section-type="dynamic-hero-slider"][data-section-data]') : null;
      var settings = { autoplay: true, duration: 5000, slideCount: 0 };

      if (data) {
        try {
          settings = JSON.parse(data.textContent);
        } catch (error) {
          console.warn('Could not parse hero slider settings', error);
        }
      }

      var track = slider.querySelector('[data-hero-slider-track]');
      var slides = Array.prototype.slice.call(slider.querySelectorAll('[data-hero-slider-slide]'));
      var dots = Array.prototype.slice.call(slider.querySelectorAll('[data-hero-slider-dot]'));
      var previous = slider.querySelector('[data-hero-slider-previous]');
      var next = slider.querySelector('[data-hero-slider-next]');
      var counter = slider.querySelector('[data-hero-slider-counter]');
      var progress = slider.querySelector('[data-hero-slider-progress]');
      var index = 0;
      var timer = null;
      var touchStartX = null;

      if (!track || slides.length <= 1) return;

      function resetProgress() {
        if (!progress) return;
        slider.classList.remove('is-playing');
        progress.style.animation = 'none';
        progress.offsetHeight;
        progress.style.animation = '';
        if (settings.autoplay) slider.classList.add('is-playing');
      }

      function goTo(nextIndex) {
        index = (nextIndex + slides.length) % slides.length;
        track.style.transform = 'translateX(-' + (index * 100) + '%)';

        slides.forEach(function (slide, slideIndex) {
          slide.classList.toggle('is-active', slideIndex === index);
        });

        dots.forEach(function (dot, dotIndex) {
          dot.classList.toggle('is-active', dotIndex === index);
        });

        if (counter) {
          counter.innerHTML = '<strong>' + (index + 1) + '</strong> / ' + slides.length;
        }

        resetProgress();
      }

      function stop() {
        if (timer) clearInterval(timer);
        timer = null;
        slider.classList.remove('is-playing');
      }

      function play() {
        stop();
        if (!settings.autoplay) return;
        timer = setInterval(function () {
          goTo(index + 1);
        }, settings.duration);
        resetProgress();
      }

      if (previous) {
        previous.addEventListener('click', function () {
          goTo(index - 1);
          play();
        });
      }

      if (next) {
        next.addEventListener('click', function () {
          goTo(index + 1);
          play();
        });
      }

      dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          goTo(Number(dot.getAttribute('data-hero-slider-dot')));
          play();
        });
      });

      slider.addEventListener('touchstart', function (event) {
        touchStartX = event.touches[0].clientX;
      }, { passive: true });

      slider.addEventListener('touchend', function (event) {
        if (touchStartX === null) return;
        var distance = touchStartX - event.changedTouches[0].clientX;
        if (Math.abs(distance) > 40) {
          goTo(index + (distance > 0 ? 1 : -1));
          play();
        }
        touchStartX = null;
      }, { passive: true });

      slider.addEventListener('mouseenter', stop);
      slider.addEventListener('mouseleave', play);

      goTo(0);
      play();
    });
  })();
</script>

{% schema %}
{
  "name": "Hero slider",
  "class": "hero-slider--section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Featured promotions"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Autoplay slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_duration",
      "label": "Autoplay duration",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show desktop arrows",
      "default": true
    },
    {
