<style>
  .shop-the-look-grid {
      display: grid;
      overflow: hidden;
      grid-template-columns: repeat({{ section.settings.images_per_row }}, 1fr);
      gap: {{ section.settings.grid_gap }}px;
      width: 100%;
  }

  @media (max-width: 768px) {
      .shop-the-look-grid {
          grid-template-columns: repeat({{ section.settings.images_per_row_mobile }}, 1fr);
      }
  }

  .shop-the-look-item {
      position: relative;
      width: 100%;
  }

  .shop-the-look-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
  }

  .image-wrapper {
      position: relative;
      width: 100%;
      padding-bottom: {{ section.settings.aspect_ratio }};
  }

  .image-wrapper > img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border-radius: {{ settings.container_border_radius | append: 'px' }};
  }

  .dot {
      content: "";
      left: 0;
      top: 0;
      bottom: 0;
      right: 0;
      border-radius: 5rem;
      transition: transform .2s ease;
      background-color: var(--item-color);
      position: absolute;
      z-index: 2;
      display: flex;
      justify-content: center;
      align-items: center;
  }

  .dot svg {
      width: {{ section.settings.icon_dim }}px;
      height: {{ section.settings.icon_dim }}px;
      color: {{ section.settings.icon_color }};
  }

  .hotspot {
      position: absolute;
      z-index: 10;
      border-radius: 5rem;
      width: {{ section.settings.hotspot_dim }}px;
      height: {{ section.settings.hotspot_dim }}px;
      left: var(--item-x);
      top: var(--item-y);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
  }

  .hotspot:after {
      content: "";
      left: -.4rem;
      top: -.4rem;
      bottom: -.4rem;
      right: -.4rem;
      border-radius: 5rem;
      background-color: {{ section.settings.hotspot_color | color_lighten: 5 }};
      position: absolute;
      animation: scale 2s ease infinite;
      animation-delay: 0.5s;
      transition: opacity .3s, visibility .3s;
  }

  .popover {
      max-width: 25rem;
      min-width: 20rem;
      position: absolute;
      top: 100%;
      opacity: 0;
      visibility: hidden;
      transform: scale(.9);
      transition: transform .3s, opacity .3s;
      padding-top: 2rem;
      overflow: hidden;
      z-index: 100;
  }

  .hotspot:hover .popover {
      transform: scale(1);
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
  }

  .popover-inner {
      background-color: white;
      box-shadow: 0 0 4rem rgba(0, 0, 0, .6);
      display: flex;
      position: relative;
      overflow: hidden;
      border-radius: {{ settings.container_border_radius | append: 'px' }};
  }

  .popover-inner .product-info {
      padding: 10px;
  }

  .popover-inner .price--compare-at.visible {
      display: none;
  }

  .popover-inner span a {
      text-decoration: none;
      color: black;
  }

  @keyframes scale {
      0% {
          transform: scale(1);
      }
      50% {
          transform: scale(1.15);
      }
      100% {
          transform: scale(1);
      }
  }
</style>

<div class="shop-the-look-grid shop-the-look-wrapper">
  {% for block in section.blocks %}
    {% if block.type == 'image' %}
      <div class="shop-the-look-item" {{ block.shopify_attributes }}>
        <div class="image-wrapper">
          {% if block.settings.image %}
            <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.image.alt | escape }}" />
          {% endif %}

          {% comment %} Hotspot 1 {% endcomment %}
          {% if block.settings.product_1 != blank or block.settings.collection_1 != blank %}
            {% if block.settings.product_1 != blank %}
              {% assign p1 = all_products[block.settings.product_1] %}
            {% elsif block.settings.collection_1 != blank %}
              {% assign c1 = collections[block.settings.collection_1] %}
            {% endif %}
            
            <div
              class="hotspot"
              style="--item-y: {{ block.settings.hotspot_1_vertical }}%; --item-x: {{ block.settings.hotspot_1_horizontal }}%; --item-color: {{ section.settings.hotspot_color }};"
            >
              <div class="dot">
                <svg width="18" height="19" viewBox="0 0 18 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M18 9.28717C18 9.48608 17.921 9.67685 17.7803 9.8175C17.6397 9.95815 17.4489 10.0372 17.25 10.0372H9.75V17.5372C9.75 17.7361 9.67098 17.9268 9.53033 18.0675C9.38968 18.2082 9.19891 18.2872 9 18.2872C8.80109 18.2872 8.61032 18.2082 8.46967 18.0675C8.32902 17.9268 8.25 17.7361 8.25 17.5372V10.0372H0.75C0.551088 10.0372 0.360322 9.95815 0.21967 9.8175C0.0790178 9.67685 0 9.48608 0 9.28717C0 9.08826 0.0790178 8.89749 0.21967 8.75684C0.360322 8.61619 0.551088 8.53717 0.75 8.53717H8.25V1.03717C8.25 0.838258 8.32902 0.647493 8.46967 0.50684C8.61032 0.366188 8.80109 0.28717 9 0.28717C9.19891 0.28717 9.38968 0.366188 9.53033 0.50684C9.67098 0.647493 9.75 0.838258 9.75 1.03717V8.53717H17.25C17.4489 8.53717 17.6397 8.61619 17.7803 8.75684C17.921 8.89749 18 9.08826 18 9.28717Z" fill="currentColor"></path>
                </svg>
              </div>
              <div class="popover">
                {% if p1 %}
                  <div class="popover-inner">
                    <img src="{{ p1.featured_image | img_url: '100x100' }}" alt="{{ p1.title }}" />
                    <span class="product-info">
                      <a href="{{ p1.url }}">{{ p1.title }}</a>
                      {% include 'product-price', class_root: 'productitem', price: p1.price, price_varies: p1.price_varies, emphasize_price: true %}
                    </span>
                  </div>
                {% elsif c1 %}
                  <div class="popover-inner">
                    <img src="{{ c1.featured_image | img_url: '100x100' }}" alt="{{ c1.title }}" />
                    <span class="product-info">
                      <a href="{{ c1.url }}">{{ c1.title }}</a>
                    </span>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}

          {% comment %} Hotspot 2 {% endcomment %}
          {% if block.settings.product_2 != blank or block.settings.collection_2 != blank %}
            {% if block.settings.product_2 != blank %}
              {% assign p2 = all_products[block.settings.product_2] %}
            {% elsif block.settings.collection_2 != blank %}
              {% assign c2 = collections[block.settings.collection_2] %}
            {% endif %}
            
            <div
              class="hotspot"
              style="--item-y: {{ block.settings.hotspot_2_vertical }}%; --item-x: {{ block.settings.hotspot_2_horizontal }}%; --item-color: {{ section.settings.hotspot_color }};"
            >
              <div class="dot">
                <svg width="18" height="19" viewBox="0 0 18 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M18 9.28717C18 9.48608 17.921 9.67685 17.7803 9.8175C17.6397 9.95815 17.4489 10.0372 17.25 10.0372H9.75V17.5372C9.75 17.7361 9.67098 17.9268 9.53033 18.0675C9.38968 18.2082 9.19891 18.2872 9 18.2872C8.80109 18.2872 8.61032 18.2082 8.46967 18.0675C8.32902 17.9268 8.25 17.7361 8.25 17.5372V10.0372H0.75C0.551088 10.0372 0.360322 9.95815 0.21967 9.8175C0.0790178 9.67685 0 9.48608 0 9.28717C0 9.08826 0.0790178 8.89749 0.21967 8.75684C0.360322 8.61619 0.551088 8.53717 0.75 8.53717H8.25V1.03717C8.25 0.838258 8.32902 0.647493 8.46967 0.50684C8.61032 0.366188 8.80109 0.28717 9 0.28717C9.19891 0.28717 9.38968 0.366188 9.53033 0.50684C9.67098 0.647493 9.75 0.838258 9.75 1.03717V8.53717H17.25C17.4489 8.53717 17.6397 8.61619 17.7803 8.75684C17.921 8.89749 18 9.08826 18 9.28717Z" fill="currentColor"></path>
                </svg>
              </div>
              <div class="popover">
                {% if p2 %}
                  <div class="popover-inner">
                    <img src="{{ p2.featured_image | img_url: '100x100' }}" alt="{{ p2.title }}" />
                    <span class="product-info">
                      <a href="{{ p2.url }}">{{ p2.title }}</a>
                      {% include 'product-price', class_root: 'productitem', price: p2.price, price_varies: p2.price_varies, emphasize_price: true %}
                    </span>
                  </div>
                {% elsif c2 %}
                  <div class="popover-inner">
                    <img src="{{ c2.featured_image | img_url: '100x100' }}" alt="{{ c2.title }}" />
                    <span class="product-info">
                      <a href="{{ c2.url }}">{{ c2.title }}</a>
                    </span>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}

          {% comment %} Hotspot 3 {% endcomment %}
          {% if block.settings.product_3 != blank or block.settings.collection_3 != blank %}
            {% if block.settings.product_3 != blank %}
              {% assign p3 = all_products[block.settings.product_3] %}
            {% elsif block.settings.collection_3 != blank %}
              {% assign c3 = collections[block.settings.collection_3] %}
            {% endif %}
            
            <div
              class="hotspot"
              style="--item-y: {{ block.settings.hotspot_3_vertical }}%; --item-x: {{ block.settings.hotspot_3_horizontal }}%; --item-color: {{ section.settings.hotspot_color }};"
            >
              <div class="dot">
                <svg width="18" height="19" viewBox="0 0 18 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M18 9.28717C18 9.48608 17.921 9.67685 17.7803 9.8175C17.6397 9.95815 17.4489 10.0372 17.25 10.0372H9.75V17.5372C9.75 17.7361 9.67098 17.9268 9.53033 18.0675C9.38968 18.2082 9.19891 18.2872 9 18.2872C8.80109 18.2872 8.61032 18.2082 8.46967 18.0675C8.32902 17.9268 8.25 17.7361 8.25 17.5372V10.0372H0.75C0.551088 10.0372 0.360322 9.95815 0.21967 9.8175C0.0790178 9.67685 0 9.48608 0 9.28717C0 9.08826 0.0790178 8.89749 0.21967 8.75684C0.360322 8.61619 0.551088 8.53717 0.75 8.53717H8.25V1.03717C8.25 0.838258 8.32902 0.647493 8.46967 0.50684C8.61032 0.366188 8.80109 0.28717 9 0.28717C9.19891 0.28717 9.38968 0.366188 9.53033 0.50684C9.67098 0.647493 9.75 0.838258 9.75 1.03717V8.53717H17.25C17.4489 8.53717 17.6397 8.61619 17.7803 8.75684C17.921 8.89749 18 9.08826 18 9.28717Z" fill="currentColor"></path>
                </svg>
              </div>
              <div class="popover">
                {% if p3 %}
                  <div class="popover-inner">
                    <img src="{{ p3.featured_image | img_url: '100x100' }}" alt="{{ p3.title }}" />
                    <span class="product-info">
                      <a href="{{ p3.url }}">{{ p3.title }}</a>
                      {% include 'product-price', class_root: 'productitem', price: p3.price, price_varies: p3.price_varies, emphasize_price: true %}
                    </span>
                  </div>
                {% elsif c3 %}
                  <div class="popover-inner">
                    <img src="{{ c3.featured_image | img_url: '100x100' }}" alt="{{ c3.title }}" />
                    <span class="product-info">
                      <a href="{{ c3.url }}">{{ c3.title }}</a>
                    </span>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "Shop the Look",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "images_per_row",
      "label": "Images per row (Desktop)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "info": "Number of images to display in a row on desktop"
    },
    {
      "type": "range",
      "id": "images_per_row_mobile",
      "label": "Images per row (Mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "info": "Number of images to display in a row on mobile"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "100%",
          "label": "1:1 (Square)"
        },
        {
          "value": "75%",
          "label": "4:3"
        },
        {
          "value": "66.67%",
          "label": "3:2"
        },
        {
          "value": "56.25%",
          "label": "16:9"
        },
        {
          "value": "133.33%",
          "label": "3:4 (Portrait)"
        }
      ],
      "default": "100%"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between images",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Hotspot Settings"
    },
    {
      "type": "color",
      "id": "hotspot_color",
      "label": "Hotspot color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "icon_dim",
      "label": "Icon size",
      "min": 10,
      "max": 75,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "hotspot_dim",
      "label": "Hotspot size",
      "min": 10,
      "max": 75,
      "step": 1,
      "default": 40,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image with Hotspots",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "header",
          "content": "Hotspot 1"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "collection",
          "id": "collection_1",
          "label": "Collection 1"
        },
        {
          "type": "range",
          "id": "hotspot_1_horizontal",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal position",
          "default": 30
        },
        {
          "type": "range",
          "id": "hotspot_1_vertical",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical position",
          "default": 30
        },
        {
          "type": "header",
          "content": "Hotspot 2"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
         {
          "type": "collection",
          "id": "collection_2",
          "label": "Collection 2"
        },
        {
          "type": "range",
          "id": "hotspot_2_horizontal",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal position",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_2_vertical",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical position",
          "default": 50
        },
        {
          "type": "header",
          "content": "Hotspot 3"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
         {
          "type": "collection",
          "id": "collection_3",
          "label": "Collection 3"
        },
        {
          "type": "range",
          "id": "hotspot_3_horizontal",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal position",
          "default": 70
        },
        {
          "type": "range",
          "id": "hotspot_3_vertical",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical position",
          "default": 70
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the Look"
    }
  ]
}
{% endschema %}